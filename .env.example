# Copy to .env (gitignored). Never commit real values.

# Hugging Face read token: enables speaker labels (pyannote models are gated).
HF_TOKEN=

# Optional overrides. Any setting can be set as SCRIBER_<SECTION>__<KEY>; see docs/CONFIGURATION.md.
# SCRIBER_MODEL__DEVICE=cpu
# SCRIBER_MODEL__LANGUAGE=auto
# SCRIBER_PATHS__INPUT_DIR=input
# SCRIBER_PATHS__OUTPUT_DIR=output
# SCRIBER_CONFIG=path/to/scriber.toml
